# Generated by Emetos from the container my app/1.
# Save it as my-app-1.container in ~/.config/containers/systemd/ (rootless) or /etc/containers/systemd/ (rootful),
# then run `systemctl --user daemon-reload` (or `systemctl daemon-reload` as root) and start my-app-1.service.
# Emetos does not install it. See podman-systemd.unit(5) for the keys.
# The container is in a pod. A pod is a .pod unit of its own, not generated here: add Pod=<name>.pod if you make one.

[Unit]
Description=my app/1

[Container]
ContainerName=my app/1
Image=registry.example.com:5000/team/app:2.0
Entrypoint=/bin/tini --
Exec=sh -c "echo $$HOME; exit 0" a;b \; "" 100%% "it's"
Environment=EMPTY=
Environment="QUOTE=say \"hi\""
Environment=PERCENT=50%%
Environment="BACKSLASH=C:\\dir"
Environment="MULTI=line1\nline2"
PublishPort=443:8443
PublishPort=[::1]::9000
Volume=/data/with space:/in
Network=host
WorkingDir=/srv/app
User=1000:1000
HostName=app.internal
Label="a=1 one"
Label=b=2

[Service]
Restart=always

[Install]
WantedBy=default.target
