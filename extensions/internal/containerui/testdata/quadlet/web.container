# Generated by Emetos from the container web.
# Save it as web.container in ~/.config/containers/systemd/ (rootless) or /etc/containers/systemd/ (rootful),
# then run `systemctl --user daemon-reload` (or `systemctl daemon-reload` as root) and start web.service.
# Emetos does not install it. See podman-systemd.unit(5) for the keys.

[Unit]
Description=web

[Container]
ContainerName=web
Image=docker.io/library/nginx:1.27
Environment=MODE=prod
Environment="GREETING=hello world"
PublishPort=5353:53/udp
PublishPort=127.0.0.1:8080:80
Volume=/srv/site:/usr/share/nginx/html:ro
Volume=webdata:/data
Network=backend
Label="note=100%% sure"
Label=tier=front

[Service]
Restart=always

[Install]
WantedBy=default.target
