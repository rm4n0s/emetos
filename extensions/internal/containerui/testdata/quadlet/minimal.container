# Generated by Emetos from the container job.
# Save it as job.container in ~/.config/containers/systemd/ (rootless) or /etc/containers/systemd/ (rootful),
# then run `systemctl --user daemon-reload` (or `systemctl daemon-reload` as root) and start job.service.
# Emetos does not install it. See podman-systemd.unit(5) for the keys.

[Unit]
Description=job

[Container]
ContainerName=job
Image=docker.io/library/busybox:1.37.0
Exec=sleep 1d
Environment=PATH=/usr/bin

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
