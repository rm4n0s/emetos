{
	"name": "Redis",
	"scopeName": "source.redis",
	"patterns": [
		{ "include": "#comment" },
		{ "include": "#command" },
		{ "include": "#argument" }
	],
	"repository": {
		"comment": {
			"match": "^\\s*(#).*$",
			"name": "comment.line.number-sign.redis",
			"captures": { "1": { "name": "punctuation.definition.comment.redis" } }
		},
		"command": {
			"match": "^\\s*([A-Za-z_][A-Za-z0-9_.\\-]*)",
			"captures": { "1": { "name": "entity.name.function.command.redis" } }
		},
		"argument": {
			"patterns": [
				{ "include": "#double-quoted" },
				{ "include": "#single-quoted" },
				{ "include": "#option" },
				{ "include": "#number" }
			]
		},
		"double-quoted": {
			"begin": "\"",
			"end": "\"|$",
			"name": "string.quoted.double.redis",
			"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.redis" } },
			"endCaptures": { "0": { "name": "punctuation.definition.string.end.redis" } },
			"patterns": [
				{ "match": "\\\\(x[0-9A-Fa-f]{2}|.)", "name": "constant.character.escape.redis" }
			]
		},
		"single-quoted": {
			"begin": "'",
			"end": "'|$",
			"name": "string.quoted.single.redis",
			"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.redis" } },
			"endCaptures": { "0": { "name": "punctuation.definition.string.end.redis" } },
			"patterns": [
				{ "match": "\\\\'", "name": "constant.character.escape.redis" }
			]
		},
		"option": {
			"match": "(?i)(?<![^\\s])(NX|XX|GT|LT|EX|PX|EXAT|PXAT|KEEPTTL|GET|MATCH|COUNT|TYPE|LIMIT|WITHSCORES|BYSCORE|BYLEX|REV|STORE|ASC|DESC|ALPHA|BY|INCR|CH|ASYNC|SYNC|MAXLEN|MINID|FIELDS|LEFT|RIGHT|BEFORE|AFTER|MIN|MAX|BLOCK|STREAMS|NOMKSTREAM|IDLE|RETRYCOUNT|FORCE|JUSTID|ID|ON|OFF)(?![^\\s])",
			"name": "constant.language.option.redis"
		},
		"number": {
			"match": "(?<![^\\s])[-+]?(?:\\d+(?:\\.\\d+)?(?:[eE][-+]?\\d+)?|inf|INF)(?![^\\s])",
			"name": "constant.numeric.redis"
		}
	}
}
