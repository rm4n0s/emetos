package temp

import (
	"reflect"
	"testing"
)

func TestCelsius_String(t *testing.T) {
	tests := []struct {
		name string
		c    Celsius
		want string
	}{
		// TODO: Add test cases.
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			if got := tt.c.String(); !reflect.DeepEqual(got, tt.want) {
				t.Errorf("Celsius.String() = %v, want %v", got, tt.want)
			}
		})
	}
}
